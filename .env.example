# Runtime mode: dry-run, live, replay, dashboard, or health.
PM_TRACKER_MODE=dry-run

# Optional override for the config file path.
PM_TRACKER_CONFIG=config.example.yaml

# Optional override for SQLite database location.
PM_TRACKER_DATABASE_URL=sqlite:///./data/polymarket_tracker.sqlite

# Optional alert endpoints. Leave empty for console-only alerts.
DISCORD_WEBHOOK_URL=
GENERIC_WEBHOOK_URL=
TELEGRAM_WEBHOOK_URL=

# Optional CLOB API credentials are not needed for this tracker unless you
# later add authenticated user-channel monitoring. Private keys are never used.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

